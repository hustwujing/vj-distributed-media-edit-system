ELEVENLABS_API_KEY=

# Natural-language task controls (API service only; empty URL disables model fallback).
VIDEO_USE_CONTROL_INTENT_URL=http://127.0.0.1:8011/v1/systemone
VIDEO_USE_CONTROL_INTENT_MODEL=jev-latest
VIDEO_USE_CONTROL_INTENT_API_KEY=
VIDEO_USE_CONTROL_INTENT_TIMEOUT_SECONDS=2

# Optional shared stream transport for live Agent output. Leave empty to use
# the durable database polling fallback.
VIDEO_USE_REDIS_URL=
VIDEO_USE_AGENT_STREAM_PREFIX=agent:events:
VIDEO_USE_AGENT_STREAM_TTL=3600
VIDEO_USE_AGENT_STREAM_MAXLEN=10000
VIDEO_USE_AGENT_TEXT_SNAPSHOT_SECONDS=5
